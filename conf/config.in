
#
# config.in - default lunar ISO variables
#

# copy this file to 'config' and edit your settings as needed

# Which arch are we compiling for? Hint: i686 or x86_64

ISO_ARCH = x86_64

# the ISO major version number
ISO_MAJOR = 1.7.0

# minor version (pre, rc, etc). leave empty for final release
ISO_MINOR =

ifeq (,$(ISO_MINOR))
  ISO_VERSION = $(ISO_MAJOR)-$(ISO_ARCH)
else
  ISO_VERSION = $(ISO_MAJOR)-$(ISO_MINOR)-$(ISO_ARCH)
endif

# the ISO codename (i.e. Lacus Autumni)
# Codename scheme: http://en.wikipedia.org/wiki/List_of_maria_on_the_Moon
# Rotate between lacus, mare and palus for each release to avoid confusion
ISO_CODENAME = Sinus Successus

# the release/offical date tag - must be in the form of YYYYMMDD
ISO_DATE = 20130531

# the iso BUILD arch:
ISO_BUILD = $(ISO_ARCH)-pc-linux-gnu

# native toolchain used to seed the bootstrap
BOOTSTRAP_HOST = $(shell gcc -dumpmachine)

# target triplet for the temporary LFS-style bootstrap toolchain
BOOTSTRAP_TARGET = $(ISO_ARCH)-lfs-linux-gnu

# optional extra cross compiler target (for example aarch64-linux-gnu)
BOOTSTRAP_CROSS_TARGET =

# where to fetch moonbase metadata from
MOONBASE_URL = https://www.lunar-linux.org/lunar

# this concatenates the full name
ISO_CNAME = $(ISO_VERSION) ($(ISO_CODENAME) - $(ISO_DATE))

# the iso label may not contain spaces
ISO_LABEL = $(shell echo -n Lunar-Linux $(ISO_CODENAME) | tr '[:space:]' _)

# which lunar core tools do we want on the ISO
ISO_LUNAR_MODULE = lunar

# set this to number of makes for parallel builds or leave empty
# ISO_MAKES = 2

# set this to the base optimization (e.g. i386, i586, i686, x86-64)
ISO_GCCARCH = x86-64

# use merged /usr layout (/bin -> usr/bin, /lib -> usr/lib, /sbin -> usr/sbin)
# set to 'yes' for merged or 'no' for traditional layout
ISO_MERGED_USR = yes

# set this to number of makes for bootstrap source builds or leave empty
# defaults to ISO_MAKES if set, otherwise 1
# BOOTSTRAP_JOBS = 2

# bootstrap can ignore transitive build helpers that lunar will install later
# BOOTSTRAP_IGNORE_MODULES = cmake dialog less meson ncurses ninja python-setuptools python-wheel python-build python-installer dbus systemd gnu-efi pciutils kbd iptables iproute2 check autoconf-archive intltool python-markupsafe python-jinja2 python-pyelftools IO-Capture Devel-CheckLib XML-Parser kmod Linux-PAM cracklib shadow e2fsprogs rpmunpack procps
